{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Giga Couch provisional manifest v1",
  "description": "Metadata validation only. The CLI also enforces unique targets/filenames and checks artifact bytes. No playability or security certification is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "game_id", "title", "release_id", "version", "runtime", "sdk", "players", "artifacts"],
  "properties": {
    "manifest_version": { "const": 1 },
    "game_id": { "$ref": "#/$defs/id" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$(?![\\s\\S])",
      "allOf": [{ "pattern": "\\S" }]
    },
    "release_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "runtime": { "type": "string", "pattern": "^[1-9][0-9]{0,2}$(?![\\s\\S])" },
    "sdk": { "$ref": "#/$defs/semver" },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max": { "type": "integer", "minimum": 1, "maximum": 16 }
      },
      "description": "The CLI additionally checks min <= max."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$(?![\\s\\S])"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$(?![\\s\\S])"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "renderer", "file", "size_bytes", "sha256"],
      "properties": {
        "os": { "enum": ["windows", "macos"] },
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "renderer": { "const": "gl_compatibility" },
        "file": {
          "type": "string",
          "maxLength": 68,
          "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?\\.pck$(?![\\s\\S])"
        },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])" }
      },
      "allOf": [
        {
          "if": { "properties": { "os": { "const": "windows" } } },
          "then": { "properties": { "architecture": { "const": "x86_64" } } }
        }
      ]
    }
  }
}
